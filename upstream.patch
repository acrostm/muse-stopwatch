+ * never starts the encrypted pairing handshake must not hide it indefinitely. */
+void sw_pairing_tick(bool restart)
+{
+    static sw_pairing_idle_t idle;
+    bool paired = config_setup_complete();
+    bool connected = ble_server_has_connection();
+    bool handshake = link_pairing_session_generation() != 0;
+    bool expired = sw_pairing_idle_expired(&idle, esp_timer_get_time(), connected, handshake, paired);
+    if (paired || (!restart && !expired)) return;
+    ESP_LOGI(TAG, "releasing idle setup connection: %s", restart ? "user request" : "no handshake for 30s");
+    ble_server_disconnect_client();
+    ble_server_begin_advertising();
+}
+
+bool sw_pairing_connected(void) { return ble_server_has_connection(); }
